---
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog')).sort((a, b) => {
	const aDate = a.data.published_at || a.data.pubDate || new Date(0);
	const bDate = b.data.published_at || b.data.pubDate || new Date(0);
	return bDate.valueOf() - aDate.valueOf();
});

// タグの集計（件数付き・件数降順）
const tagCounts = new Map<string, number>();
allPosts.forEach((post) => {
	if (post.data.tag) {
		post.data.tag.forEach((t) => {
			tagCounts.set(t, (tagCounts.get(t) || 0) + 1);
		});
	}
});
const tags = Array.from(tagCounts.entries()).sort((a, b) => b[1] - a[1]);

// 年月アーカイブの集計（新しい順）
interface ArchiveItem {
	year: string;
	month: string;
	label: string;
	count: number;
}
const archiveMap = new Map<string, ArchiveItem>();
allPosts.forEach((post) => {
	const date = post.data.published_at || post.data.pubDate || new Date(0);
	const year = date.getFullYear().toString();
	const month = String(date.getMonth() + 1).padStart(2, '0');
	const key = `${year}/${month}`;
	if (!archiveMap.has(key)) {
		archiveMap.set(key, {
			year,
			month,
			label: `${year}年${parseInt(month, 10)}月`,
			count: 0,
		});
	}
	archiveMap.get(key)!.count++;
});
const archives = Array.from(archiveMap.values());

// 最新記事（4件）
const recentPosts = allPosts.slice(0, 4);
---

<div class="sidebar-content">
	{/* モバイル表示時の閉じるボタンヘッダー */}
	<div class="sidebar-header-mobile">
		<span class="sidebar-header-title">メニュー</span>
		<button id="sidebar-close-btn" class="close-btn" aria-label="メニューを閉じる">
			✕
		</button>
	</div>

	{/* プロフィールウィジェット */}
	<div class="sidebar-widget profile-widget">
		<div class="profile-header">
			<img src="/13.png" alt="つめあり" class="profile-avatar" />
			<span class="profile-name">つめあり</span>
		</div>
		<p class="profile-desc">日常や趣味（ウマ娘、麻雀、旅行など）を気ままに記録する個人ブログです。</p>
		<div class="profile-sns">
			<a href="https://x.com/kabinoyama_beya" target="_blank" rel="noopener noreferrer" class="sns-badge x-badge">X</a>
			<a href="https://bsky.app/profile/housnorlax.bsky.social" target="_blank" rel="noopener noreferrer" class="sns-badge bsky-badge">Bluesky</a>
			<a href="https://www.youtube.com/@kabinoyama_beya" target="_blank" rel="noopener noreferrer" class="sns-badge yt-badge">YouTube</a>
		</div>
	</div>

	{/* ナビゲーションウィジェット */}
	<div class="sidebar-widget">
		<h3 class="widget-title">メニュー</h3>
		<ul class="nav-list">
			<li>
				<a href="/" class="nav-item-link">ホーム</a>
			</li>
			<li>
				<a href="/posts" class="nav-item-link">すべての記事</a>
			</li>
		</ul>
	</div>

	{/* タグ別リンク */}
	<div class="sidebar-widget">
		<h3 class="widget-title">タグ</h3>
		<div class="tag-cloud">
			{tags.map(([tagName, count]) => (
				<a href={`/posts/search/${tagName}`} class="sidebar-tag-badge">
					<span>{tagName}</span>
					<span class="tag-count">{count}</span>
				</a>
			))}
		</div>
	</div>

	{/* 投稿年月別アーカイブ */}
	<div class="sidebar-widget">
		<h3 class="widget-title">月別アーカイブ</h3>
		<ul class="archive-list">
			{archives.map((item) => (
				<li>
					<a href={`/posts/archive/${item.year}/${item.month}`} class="archive-item-link">
						<span class="archive-label">{item.label}</span>
						<span class="archive-count">{item.count}</span>
					</a>
				</li>
			))}
		</ul>
	</div>

	{/* 最新記事 */}
	<div class="sidebar-widget">
		<h3 class="widget-title">最近の投稿</h3>
		<ul class="recent-list">
			{recentPosts.map((post) => {
				const dateVal = post.data.published_at || post.data.pubDate || new Date();
				const formattedDate = dateVal.toLocaleDateString("ja-JP", {
					year: 'numeric',
					month: '2-digit',
					day: '2-digit'
				});
				return (
					<li>
						<a href={`/posts/${post.slug}`} class="recent-item-link">
							<span class="recent-title">{post.data.title}</span>
							<time class="recent-date">{formattedDate}</time>
						</a>
					</li>
				);
			})}
		</ul>
	</div>
</div>

