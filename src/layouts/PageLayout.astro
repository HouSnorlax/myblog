---
import Layout from './Layout.astro';

interface Props {
	frontmatter: {
		title?: string;
		description?: string;
		snippet?: string;
		pubDate?: string | Date;
		updatedDate?: string | Date;
		tags?: string[];
	};
}

const { frontmatter } = Astro.props;
const title = frontmatter?.title || '太鼓の記録';
const description = frontmatter?.description || frontmatter?.snippet || '太鼓の達人の記録ページです。';
const dateVal = frontmatter?.updatedDate ? new Date(frontmatter.updatedDate) : (frontmatter?.pubDate ? new Date(frontmatter.pubDate) : new Date());
const formattedDate = dateVal.toLocaleDateString("ja-JP", {
	year: 'numeric',
	month: '2-digit',
	day: '2-digit'
});
---

<Layout
	title={`${title} - MUHO's Blog`}
	description={description}
>
	<a href="/" class="back-link">← 戻る</a>
	
	<article class="article-container">
		<h1 class="article-title">{title}</h1>
		<time class="article-date" datetime={dateVal.toISOString()}>
			最終更新: {formattedDate}
		</time>

		<div class="article-body">
			<slot />
		</div>

		{frontmatter?.tags && frontmatter.tags.length > 0 && (
			<div class="tag-container">
				<span class="tag-label">タグ:</span>
				{frontmatter.tags.map((tag) => (
					<span class="tag-badge">
						{tag}
					</span>
				))}
			</div>
		)}
	</article>
</Layout>

<style>
	.back-link {
		display: inline-block;
		margin-bottom: 1.5rem;
		color: #2563eb;
		text-decoration: none;
		font-weight: 500;
		transition: color 0.2s ease, transform 0.2s ease;
	}

	.back-link:hover {
		color: #1d4ed8;
		transform: translateX(-4px);
	}

	.article-container {
		background: #ffffff;
		border: 1px solid #e2e8f0;
		border-radius: 12px;
		padding: 2rem;
		box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
		box-sizing: border-box;
		width: 100%;
		overflow-wrap: break-word;
		word-break: break-word;
	}

	.article-title {
		font-size: 2.25rem;
		font-weight: 800;
		color: #1e293b;
		margin-top: 0;
		margin-bottom: 0.5rem;
		line-height: 1.3;
		overflow-wrap: break-word;
		word-break: break-word;
	}

	.article-date {
		font-size: 0.95rem;
		color: #64748b;
		display: block;
		margin-bottom: 2rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid #e2e8f0;
	}

	/* Styled typography for the post body */
	.article-body {
		font-size: 1.05rem;
		line-height: 1.8;
		color: #334155;
		overflow-wrap: break-word;
		word-break: break-word;
	}

	.article-body :global(h1),
	.article-body :global(h2),
	.article-body :global(h3),
	.article-body :global(h4) {
		color: #1e293b;
		font-weight: 700;
		margin-top: 2rem;
		margin-bottom: 1rem;
		overflow-wrap: break-word;
		word-break: break-word;
	}

	.article-body :global(h1) { font-size: 1.6rem; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.5rem; }
	.article-body :global(h2) { font-size: 1.35rem; border-bottom: 1px solid #f1f5f9; padding-bottom: 0.25rem; }
	.article-body :global(h3) { font-size: 1.15rem; }
	.article-body :global(h4) { font-size: 1.05rem; }

	.article-body :global(p) {
		margin-bottom: 1.25rem;
		overflow-wrap: break-word;
		word-break: break-word;
	}

	.article-body :global(ul),
	.article-body :global(ol) {
		margin-bottom: 1.25rem;
		padding-left: 1.5rem;
		overflow-wrap: break-word;
		word-break: break-word;
	}

	.article-body :global(li) {
		margin-bottom: 0.5rem;
	}

	.article-body :global(code) {
		font-family: monospace;
		background-color: #f1f5f9;
		padding: 0.2rem 0.4rem;
		border-radius: 4px;
		font-size: 0.9em;
		color: #0f172a;
		word-break: break-word;
	}

	.article-body :global(pre) {
		background-color: #0f172a;
		color: #f8fafc;
		padding: 1rem;
		border-radius: 8px;
		overflow-x: auto;
		margin-bottom: 1.25rem;
		max-width: 100%;
		box-sizing: border-box;
	}

	.article-body :global(pre code) {
		background-color: transparent;
		padding: 0;
		border-radius: 0;
		color: inherit;
		font-size: 0.9em;
		word-break: normal;
	}

	.article-body :global(blockquote) {
		border-left: 4px solid #3b82f6;
		background-color: #eff6ff;
		padding: 0.75rem 1rem;
		margin: 0 0 1.25rem 0;
		border-radius: 0 8px 8px 0;
		font-style: italic;
		color: #1e3a8a;
		overflow-wrap: break-word;
		word-break: break-word;
	}

	.article-body :global(a) {
		color: #2563eb;
		text-decoration: none;
		border-bottom: 1px dashed #2563eb;
		word-break: break-word;
		overflow-wrap: anywhere;
	}

	.article-body :global(a:hover) {
		color: #1d4ed8;
		border-bottom-style: solid;
	}

	.article-body :global(img) {
		display: block;
		max-width: 100%;
		height: auto;
		border-radius: 8px;
		margin: 1.5rem auto;
		box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
	}

	.article-body :global(table) {
		display: table;
		width: 100%;
		max-width: 100%;
		overflow-x: auto;
		border-collapse: collapse;
		margin: 1.5rem 0;
	}

	.article-body :global(th),
	.article-body :global(td) {
		border: 1px solid #e2e8f0;
		padding: 0.65rem 0.85rem;
		text-align: left;
		font-size: 0.95rem;
	}

	.article-body :global(th) {
		background-color: #f8fafc;
		font-weight: 600;
		color: #1e293b;
	}

	.article-body :global(tr:nth-child(even)) {
		background-color: #f8fafc;
	}

	.tag-container {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		align-items: center;
		font-size: 0.9rem;
		color: #64748b;
		margin-top: 2rem;
		padding-top: 1rem;
		border-top: 1px solid #e2e8f0;
	}

	.tag-label {
		font-weight: 600;
	}

	.tag-badge {
		background-color: #f1f5f9;
		color: #475569;
		padding: 0.2rem 0.6rem;
		border-radius: 6px;
		font-weight: 500;
		border: 1px solid #cbd5e1;
	}

	@media (max-width: 640px) {
		.article-container {
			padding: 1.25rem 1rem;
		}
		.article-title {
			font-size: 1.45rem;
			line-height: 1.35;
		}
		.article-date {
			font-size: 0.85rem;
			margin-bottom: 1.5rem;
			padding-bottom: 0.75rem;
		}
		.article-body {
			font-size: 0.95rem;
			line-height: 1.7;
		}
		.article-body :global(h1) { font-size: 1.3rem; margin-top: 1.5rem; }
		.article-body :global(h2) { font-size: 1.15rem; margin-top: 1.25rem; }
		.article-body :global(h3) { font-size: 1.05rem; }
		.article-body :global(pre) {
			padding: 0.75rem;
			font-size: 0.85rem;
		}
		.article-body :global(table) {
			display: block;
			overflow-x: auto;
		}
		.article-body :global(th),
		.article-body :global(td) {
			padding: 0.5rem 0.6rem;
			font-size: 0.85rem;
		}
		.tag-container {
			font-size: 0.85rem;
			gap: 0.35rem;
		}
		.tag-badge {
			padding: 0.15rem 0.5rem;
			font-size: 0.8rem;
		}
	}
</style>
