---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, snippet, pubDate, published_at, updatedDate, heroImage } = Astro.props;
const displayDate = pubDate || published_at || new Date();
const displayDescription = description || snippet || '';
---

<html lang="en">
	<head>
		<BaseHead title={title} description={displayDescription} />
		<style>
			main {
				width: 100%;
				max-width: 768px;
				margin: 0 auto;
				padding: 2rem 1rem;
				box-sizing: border-box;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
				max-width: 100%;
				height: auto;
			}
			.prose {
				width: 100%;
				max-width: 768px;
				margin: auto;
				padding: 1rem 0;
				color: rgb(var(--gray-dark));
				box-sizing: border-box;
				overflow-wrap: break-word;
				word-break: break-word;
			}
			.title {
				margin-bottom: 1.5em;
				padding: 1em 0;
				text-align: center;
				line-height: 1.2;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
				font-size: 2.25em;
				overflow-wrap: break-word;
				word-break: break-word;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			@media (max-width: 640px) {
				main {
					padding: 1.25rem 0.75rem;
				}
				.title h1 {
					font-size: 1.5em;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={displayDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
